# ==========================================
# Root environment file for Podman Compose
# ==========================================

# Set this to your local IP address (e.g. 192.168.1.50) to allow access from remote PCs
HOST_IP=localhost

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=employeeManagement

# Fallback Deployed Render Links (for reference or selective remote integration)
# To use a deployed link for a frontend, set its VITE_*_MF_URL to the deployed URL.
# To use a deployed link for a backend, set its respective VITE_*_API variable to the deployed URL.

# Frontends (Render links)
DEPLOYED_HOST_URL=https://hostapp-h09n.onrender.com/
DEPLOYED_EMPLOYEE_MF_URL=https://employeesfederation.onrender.com/assets/remoteEntry.js
DEPLOYED_ASSET_MF_URL=https://assetmanagementsystem-0sqh.onrender.com/assets/remoteEntry.js
DEPLOYED_HELPDESK_MF_URL=https://helpdesk-frontend-45xw.onrender.com/assets/remoteEntry.js
DEPLOYED_INVENTORY_MF_URL=https://inventorymanagement-rm.onrender.com/assets/remoteEntry.js

# Backends (Render links)
